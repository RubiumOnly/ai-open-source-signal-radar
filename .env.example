# Live 模式必填项按实际模型提供商选择；Replay 模式不读取这些变量。
# 推荐的低成本开发配置：Key 只写在本机 .env，不要提交到 Git。
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 也可以改用 OpenAI-compatible 的其他提供商。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 可选：GitHub API 提高速率限制。只读 Token，不要提交真实值。
GITHUB_TOKEN=

# 可选：运行配置
SIGNAL_RADAR_MODE=replay
SIGNAL_RADAR_REPORT_DIR=reports
SIGNAL_RADAR_HISTORY_DB=data/runs.sqlite3

# Browser Use 动态页面采集默认关闭；只有本地/受控环境显式开启。
SIGNAL_RADAR_BROWSER_ENABLED=false
SIGNAL_RADAR_BROWSER_RUN_LIVE=false
SIGNAL_RADAR_BROWSER_ALLOWED_DOMAINS=github.com
SIGNAL_RADAR_BROWSER_MAX_STEPS=12
SIGNAL_RADAR_BROWSER_TIMEOUT_SECONDS=180

# browser-use 的匿名运行遥测；默认关闭，按需改为 true。
ANONYMIZED_TELEMETRY=false

# 可选：逗号分隔的公开 RSS/Atom feed，用于官方博客或产品更新。
SIGNAL_RADAR_RSS_FEEDS=

# API 跨域来源；生产环境应改成实际前端地址，避免任意站点触发 Live 运行。
SIGNAL_RADAR_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Hacker News Algolia 公开社区来源的边界；查询默认使用项目名。
SIGNAL_RADAR_HACKERNEWS_TIMEOUT=8
SIGNAL_RADAR_HACKERNEWS_MAX_LIMIT=50

