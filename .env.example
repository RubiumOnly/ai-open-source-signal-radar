# Live 模式必填项按实际模型提供商选择；Replay 模式不读取这些变量。
# 推荐的低成本开发配置：Key 只写在本机 .env，不要提交到 Git。
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 也可以改用 OpenAI-compatible 的其他提供商。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 可选：GitHub API 提高速率限制。只读 Token，不要提交真实值。
GITHUB_TOKEN=

# 可选：运行配置
SIGNAL_RADAR_MODE=replay
SIGNAL_RADAR_REPORT_DIR=reports
SIGNAL_RADAR_HISTORY_DB=data/runs.sqlite3
# 公开来源的增量元数据缓存；只保存 ETag、Last-Modified 和记录指纹。
SIGNAL_RADAR_CACHE_ENABLED=true
SIGNAL_RADAR_CACHE_DB=data/source-cache.sqlite3

# Browser Use 动态页面采集默认关闭；只有本地/受控环境显式开启。
SIGNAL_RADAR_BROWSER_ENABLED=false
SIGNAL_RADAR_BROWSER_RUN_LIVE=false
SIGNAL_RADAR_BROWSER_ALLOWED_DOMAINS=github.com
SIGNAL_RADAR_BROWSER_MAX_STEPS=12
SIGNAL_RADAR_BROWSER_TIMEOUT_SECONDS=180
# 登录态只允许在本机显式授权时使用；路径必须是已有的绝对本地 Profile 目录。
SIGNAL_RADAR_BROWSER_AUTHORIZED=false
SIGNAL_RADAR_BROWSER_PROFILE_DIR=
SIGNAL_RADAR_BROWSER_PROFILE_NAME=Default

# browser-use 的匿名运行遥测；默认关闭，按需改为 true。
ANONYMIZED_TELEMETRY=false

# 可选：逗号分隔的公开 RSS/Atom feed，用于官方博客或产品更新。
SIGNAL_RADAR_RSS_FEEDS=

# API 跨域来源；生产环境应改成实际前端地址，避免任意站点触发 Live 运行。
SIGNAL_RADAR_CORS_ORIGINS=http://localhost:4174,http://127.0.0.1:4174,http://localhost:4173,http://127.0.0.1:4173

# 可选：启用 API Bearer 认证。留空时保持本地开发的无认证行为；启用后，
# /api/run、/api/runs、运行历史、取消和 Markdown 导出等运行控制接口要求
# Authorization: Bearer <token>。不要把真实 Token 提交到 Git。
SIGNAL_RADAR_API_TOKEN=

# Hacker News Algolia 公开社区来源的边界；查询默认使用项目名。
SIGNAL_RADAR_HACKERNEWS_TIMEOUT=8
SIGNAL_RADAR_HACKERNEWS_MAX_LIMIT=50
SIGNAL_RADAR_HACKERNEWS_MAX_PAGES=4

# 本地定时调度默认关闭；只有显式 POST /api/schedule 或 CLI --schedule 才会启动。
# 每次运行仍沿用只读来源、单次预算和历史记录边界。
SIGNAL_RADAR_SCHEDULER_MODE=replay
SIGNAL_RADAR_SCHEDULER_PROJECT=browser-use/browser-use
SIGNAL_RADAR_SCHEDULER_SOURCES=github
SIGNAL_RADAR_SCHEDULER_FEEDS=
SIGNAL_RADAR_SCHEDULER_URLS=
SIGNAL_RADAR_SCHEDULER_COMMUNITY_QUERY=
SIGNAL_RADAR_SCHEDULER_STACKOVERFLOW_QUERY=
SIGNAL_RADAR_SCHEDULER_WINDOW_DAYS=7
SIGNAL_RADAR_SCHEDULER_LIMIT=20
SIGNAL_RADAR_SCHEDULER_INTERVAL_SECONDS=3600
SIGNAL_RADAR_SCHEDULER_MAX_RUNS=100
SIGNAL_RADAR_SCHEDULER_RUN_IMMEDIATELY=false
SIGNAL_RADAR_REDDIT_TIMEOUT=8
SIGNAL_RADAR_REDDIT_MAX_LIMIT=50
SIGNAL_RADAR_REDDIT_MAX_PAGES=4

# Stack Exchange 公共 API；只有请求 sources=stackoverflow 时访问。
SIGNAL_RADAR_STACKEXCHANGE_SITE=stackoverflow
SIGNAL_RADAR_STACKEXCHANGE_TIMEOUT=8
SIGNAL_RADAR_STACKEXCHANGE_MAX_LIMIT=50
SIGNAL_RADAR_STACKEXCHANGE_MAX_PAGES=4

